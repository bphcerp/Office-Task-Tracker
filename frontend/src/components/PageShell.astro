---
interface Props {
  title: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  subtitle,
  backHref,
  backLabel = 'Back to tasks',
} = Astro.props;
---

<main class="shell">
  {backHref && (
    <a class="back" href={backHref}>
      ← {backLabel}
    </a>
  )}
  <header class="page-header">
    <h1>{title}</h1>
    {subtitle && <p class="subtitle">{subtitle}</p>}
  </header>
  <slot />
</main>

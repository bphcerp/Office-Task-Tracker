---
import type { Task } from '../lib/types';
import {
  formatDateTime,
  formatRelativeTime,
  formatStatusLabel,
  personDisplayName,
  personInitial,
  statusTone,
  TASK_STATUS_OPTIONS,
} from '../lib/task-ui';

interface Props {
  task: Task;
}

const { task } = Astro.props;
const tone = statusTone(task.status);
const receivedAt = task.source_email_received_at ?? task.created_at;
---

<div class="task-hero">
  <span class={`badge badge--${tone}`} data-status-badge>{formatStatusLabel(task.status)}</span>
  <h2 class="task-hero__title">{task.title}</h2>
  <p class="task-hero__when" title={formatDateTime(receivedAt)}>
    {formatRelativeTime(receivedAt)}
  </p>
</div>

<section class="panel" data-status-editor data-task-id={task.id} data-status={task.status}>
  <h3 class="panel-title">Status</h3>
  <div class="status-picker" role="group" aria-label="Task status">
    {
      TASK_STATUS_OPTIONS.map((option) => (
        <button
          type="button"
          class={`status-picker__option${option.value === task.status ? ' is-active' : ''}`}
          data-status-option
          data-status-value={option.value}
          aria-pressed={option.value === task.status ? 'true' : 'false'}
        >
          {option.label}
        </button>
      ))
    }
  </div>
  <p class="status-picker__feedback" data-status-feedback hidden></p>
</section>

<section class="panel">
  <h3 class="panel-title">Summary</h3>
  <p class="task-summary">{task.summary?.body ?? 'No summary available.'}</p>
</section>

<section class="panel">
  <h3 class="panel-title">Assigned person</h3>
  {
    task.person ? (
      <div class="task-person">
        <span class="task-person__avatar" aria-hidden="true">
          {personInitial(task.person.name, task.person.email)}
        </span>
        <div>
          <p class="task-person__name">
            {personDisplayName(task.person.name, task.person.email)}
          </p>
          <p class="task-person__email">{task.person.email ?? 'No email on file'}</p>
        </div>
      </div>
    ) : (
      <p class="state">No person was linked to this task.</p>
    )
  }
</section>

<section class="panel">
  <h3 class="panel-title">Source &amp; timestamps</h3>
  <dl class="task-meta-grid">
    <div>
      <dt>Email received</dt>
      <dd>{formatDateTime(task.source_email_received_at)}</dd>
    </div>
    <div>
      <dt>Created in tracker</dt>
      <dd>{formatDateTime(task.created_at)}</dd>
    </div>
    <div>
      <dt>Last updated</dt>
      <dd data-updated-at>{formatDateTime(task.updated_at)}</dd>
    </div>
    <div>
      <dt>Source email ID</dt>
      <dd class="mono">{task.source_email_id ?? '—'}</dd>
    </div>
  </dl>
</section>

<section class="task-delete" data-task-delete>
  <div class="task-delete__content">
    <h3 class="task-delete__title">Delete task</h3>
    <p class="task-delete__desc">Permanently remove this task from the tracker. This cannot be undone.</p>
  </div>
  <button type="button" class="task-delete__button" data-delete-trigger>Delete</button>
  <p class="task-delete__feedback" data-delete-feedback hidden></p>
</section>

<script>
  import { deleteTask, updateTaskStatus } from '../lib/tasks-client';
  import { formatDateTime, formatStatusLabel, statusTone } from '../lib/task-ui';
  import type { TaskStatusValue } from '../lib/types';

  const editor = document.querySelector<HTMLElement>('[data-status-editor]');
  const taskId = editor ? Number(editor.dataset.taskId) : 0;

  if (editor && taskId) {
    const badge = document.querySelector<HTMLElement>('[data-status-badge]');
    const feedback = editor.querySelector<HTMLElement>('[data-status-feedback]');
    const updatedAt = document.querySelector<HTMLElement>('[data-updated-at]');
    const options = editor.querySelectorAll<HTMLButtonElement>('[data-status-option]');

    function setActiveStatus(status: TaskStatusValue): void {
      editor.dataset.status = status;

      for (const button of options) {
        const isActive = button.dataset.statusValue === status;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      }

      if (badge) {
        badge.textContent = formatStatusLabel(status);
        badge.classList.remove('badge--todo', 'badge--progress', 'badge--done');
        badge.classList.add(`badge--${statusTone(status)}`);
      }
    }

    for (const button of options) {
      button.addEventListener('click', async () => {
        const nextStatus = button.dataset.statusValue as TaskStatusValue;
        if (nextStatus === editor.dataset.status) return;

        const previousStatus = editor.dataset.status as TaskStatusValue;
        for (const option of options) option.disabled = true;
        if (feedback) {
          feedback.hidden = true;
          feedback.textContent = '';
        }
        setActiveStatus(nextStatus);

        try {
          const task = await updateTaskStatus(taskId, nextStatus);
          setActiveStatus(task.status);
          if (updatedAt) {
            updatedAt.textContent = formatDateTime(task.updated_at);
          }
        } catch (err) {
          setActiveStatus(previousStatus);
          if (feedback) {
            feedback.hidden = false;
            feedback.textContent =
              err instanceof Error ? err.message : 'Failed to update status';
          }
        } finally {
          for (const option of options) option.disabled = false;
        }
      });
    }
  }

  const deleteRoot = document.querySelector<HTMLElement>('[data-task-delete]');
  const deleteButton = deleteRoot?.querySelector<HTMLButtonElement>('[data-delete-trigger]');
  const deleteFeedback = deleteRoot?.querySelector<HTMLElement>('[data-delete-feedback]');

  if (deleteButton && deleteFeedback && taskId) {
    deleteButton.addEventListener('click', async () => {
      if (!window.confirm('Delete this task? This cannot be undone.')) return;

      deleteButton.disabled = true;
      deleteFeedback.hidden = true;
      deleteFeedback.textContent = '';

      try {
        await deleteTask(taskId);
        window.location.href = '/';
      } catch (err) {
        deleteFeedback.hidden = false;
        deleteFeedback.textContent =
          err instanceof Error ? err.message : 'Failed to delete task';
        deleteButton.disabled = false;
      }
    });
  }
</script>

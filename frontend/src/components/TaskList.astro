---
import type { Task } from '../lib/types';
import TaskCard from './TaskCard.astro';

interface Props {
  tasks: Task[];
}

const { tasks } = Astro.props;
---

{
  tasks.length === 0 ? (
    <div class="empty-panel">
      <h2>No tasks yet</h2>
      <p class="state">Ingest emails from the backend to populate this list.</p>
    </div>
  ) : (
    <>
      <p class="task-count">
        {tasks.length} task{tasks.length === 1 ? '' : 's'}
      </p>
      <ul class="task-list">
        {tasks.map((task) => (
          <TaskCard task={task} />
        ))}
      </ul>
    </>
  )
}

---
import Layout from '../layouts/Layout.astro';
import IngestButton from '../components/IngestButton.astro';
import PageShell from '../components/PageShell.astro';
import SettingsLink from '../components/SettingsLink.astro';
import TaskList from '../components/TaskList.astro';
import { fetchTasks } from '../lib/api';
import type { Task } from '../lib/types';

export const prerender = false;

const title = 'Office Task Tracker';

let tasks: Task[] = [];
let error: string | null = null;

try {
  tasks = await fetchTasks();
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to load tasks';
}
---

<Layout>
  <PageShell title={title} subtitle="Classified office tasks scraped from your inbox.">
    <IngestButton slot="actions" />
    <SettingsLink slot="actions" />
    {error ? <p class="state state--error">{error}</p> : <TaskList tasks={tasks} />}
  </PageShell>
</Layout>
